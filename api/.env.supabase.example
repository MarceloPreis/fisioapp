# Copy to api/.env only for an isolated validation installation. No real patient data.
NODE_ENV=production
PORT=3000
STORAGE_PROVIDER=supabase
CLOUD_VALIDATION_ONLY=true
HL7_ENABLED=false
SUPABASE_URL=https://<project-reference>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=videos
MAX_VIDEO_MB=50

# Session pooler; use the restricted runtime role, NOT postgres.
# URL-encode special characters in the password. Do not add sslmode query parameters.
DATABASE_URL=postgresql://sitf_runtime.<project-reference>:<encoded-password>@<session-pooler-host>:5432/postgres
DB_SSL=true
# Optional trusted CA in PEM format; literal \n is accepted.
DB_SSL_CA=
# Alternative local file path or Render secret-file path, e.g. /etc/secrets/supabase-ca.crt.
DB_SSL_CA_FILE=
DB_POOL_SIZE=5
DB_SYNCHRONIZE=false
# Administrative connection for local migration commands ONLY. Do not add it to Render.
MIGRATION_DATABASE_URL=

JWT_SECRET=
CORS_ORIGINS=https://sitf-validation.onrender.com
SERVE_WEB=true
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TENANT_ID=00000000-0000-4000-8000-000000000001
