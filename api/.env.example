NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=
DB_NAME=tele_rehab
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
DB_POOL_SIZE=5
# Optional URLs; migrations can use a separate administrative connection.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_SYNCHRONIZE=false
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TENANT_ID=00000000-0000-4000-8000-000000000001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_PROVIDER=minio
STORAGE_BUCKET=videos
# Empty selects 512 MB for MinIO or 50 MB for Supabase.
MAX_VIDEO_MB=
CLOUD_VALIDATION_ONLY=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SERVE_WEB=false
HL7_ENABLED=false
HL7_HOST=127.0.0.1
HL7_PORT=2575
HL7_ALLOWED_IPS=127.0.0.1
HL7_TENANT_ID=00000000-0000-4000-8000-000000000001
# Set only after confirming every legacy record belongs to the same clinic.
LEGACY_SINGLE_TENANT_CONFIRMED=false
# Optional separate secret; backup script otherwise uses the local DB password.
BACKUP_ENCRYPTION_PASSWORD=
